# Server
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/telemetry

# GitHub OAuth (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Security (generate with: openssl rand -base64 32)
COOKIE_SECRET=your_random_32_char_string
VISITOR_SALT=another_random_32_char_string

# URLs
BASE_URL=https://usetelemetry.hogyoku.cloud
FRONTEND_URL=https://usetelemetry.vercel.app
GITHUB_URL=https://api.github.com

# MaxMind GeoLite2 City database. On a server running geoipupdate, point this
# at /usr/share/GeoIP/GeoLite2-City.mmdb.
GEOIP_DB_PATH=./GeoLite2-City.mmdb

# Discord webhook for event-volume drop alerts. Leave unset locally so dev
# data never posts to the production channel.
ALERT_WEBHOOK_URL=
